{
  "name": "mibarra",
  "private": true,
  "description": "Coffee shop app to order drinks and loyalty rewards",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"supabase/functions/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "supabase start && node scripts/write-local-env.mjs && concurrently -k -n functions,dashboard -c magenta,yellow \"supabase functions serve\" \"npm run dashboard\"",
    "dev:stop": "supabase stop",
    "mobile": "npm run start -w @mibarra/mobile",
    "dashboard": "npm run start -w @mibarra/dashboard",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "functions:serve": "supabase functions serve",
    "deploy:mobile": "npm run deploy -w @mibarra/mobile",
    "deploy:dashboard": "npm run deploy -w @mibarra/dashboard"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "supabase": "^2.40.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.40.0"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "decode-uri-component": "^0.5.1"
  }
}
